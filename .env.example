# Copy to .env and edit. All values have defaults in src/lowres_asr/settings.py.

# PostgreSQL (psycopg v3 driver). Create the database first:
#   createdb awaaz && psql -c "create user awaaz with password 'awaaz'; grant all on database awaaz to awaaz;"
DATABASE_URL=postgresql+psycopg://awaaz:awaaz@localhost:5432/awaaz

# Redis: Celery broker and result backend.
REDIS_URL=redis://127.0.0.1:6379/0

# Audio storage.
#   local       development: files under STORAGE_DIR on this machine
#   cloudinary  production: originals and 16 kHz WAVs as Cloudinary "video" assets
STORAGE_BACKEND=local
STORAGE_DIR=data/recordings
# From the Cloudinary console (Dashboard -> API Keys). Required when STORAGE_BACKEND=cloudinary.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Top-level folder in the Media Library. Assets land at <folder>/<lang>/<yyyy>/<mm>/<id>.
CLOUDINARY_FOLDER=awaaz

# Comma-free JSON list of allowed browser origins.
CORS_ORIGINS=["http://localhost:5173"]

# Bearer token for /api/export. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Worker acceptance rules
MIN_CLIP_SECONDS=1.0
MAX_CLIP_SECONDS=15.0
SILENCE_RMS_THRESHOLD=0.004
VOTES_TO_SETTLE=2

# Upload abuse limits
RECORDING_RATE_LIMIT=30/minute
MAX_UPLOAD_BYTES=10485760
